<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ports_view_list" model="ir.ui.view">
        <field name="name">codestorm.ports.list</field>
        <field name="model">codestorm.ports</field>
        <field name="arch" type="xml">
            <list>
                <field name="codice"/>
                <field name="name"/>
                <field name="citta"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <record id="ports_view_form" model="ir.ui.view">
        <field name="name">codestorm.ports.form</field>
        <field name="model">codestorm.ports</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archiviato" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <h1><field name="name" placeholder="Nome porto"/></h1>
                    <group>
                        <group>
                            <field name="codice"/>
                            <field name="citta"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Note..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ports_action" model="ir.actions.act_window">
        <field name="name">Porti</field>
        <field name="res_model">codestorm.ports</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="ports_menu" name="Porti"
              parent="cruises_menu_config" action="ports_action" sequence="20"/>
</odoo>
