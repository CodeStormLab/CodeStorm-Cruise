<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cruises_view_list" model="ir.ui.view">
        <field name="name">codestorm.cruises.list</field>
        <field name="model">codestorm.cruises</field>
        <field name="arch" type="xml">
            <list>
                <field name="codice"/>
                <field name="name"/>
                <field name="cliente_id"/>
                <field name="ship_id"/>
                <field name="data_inizio"/>
                <field name="stato" widget="badge"/>
                <field name="budget" sum="Totale"/>
                <field name="image" widget="image" options="{'size': [0, 32]}" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cruises_view_form" model="ir.ui.view">
        <field name="name">codestorm.cruises.form</field>
        <field name="model">codestorm.cruises</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stato" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image', 'size': [128, 128]}"/>
                    <h1><field name="name" placeholder="Nome"/></h1>
                    <group>
                        <group>
                            <field name="codice"/>
                            <field name="cliente_id"/>
                            <field name="ship_id"/>
                            <field name="responsabile_id"/>
                        </group>
                        <group>
                            <field name="data_inizio"/>
                            <field name="data_fine"/>
                            <field name="durata_giorni"/>
                            <field name="budget"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tappe" name="tappe">
                            <field name="stop_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="port_id"/>
                                    <field name="data_arrivo"/>
                                    <field name="data_partenza"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" placeholder="Note..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cruises_action" model="ir.actions.act_window">
        <field name="name">Cruise</field>
        <field name="res_model">codestorm.cruises</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="cruises_menu_root" name="Codestorm Cruises"/>
    <menuitem id="cruises_menu" name="Cruise"
              parent="cruises_menu_root" action="cruises_action" sequence="10"/>
    <menuitem id="cruises_menu_config" name="Configurazione"
              parent="cruises_menu_root" sequence="100"/>
</odoo>
